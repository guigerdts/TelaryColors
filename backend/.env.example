# Telary Color backend — environment template.
# Copy to backend/.env and adjust for your LAN. Never commit .env.
# Loaded by app/core/config.py (pydantic-settings).

# Application title shown in OpenAPI / Swagger UI.
APP_NAME=Telary Color API

# SQLAlchemy database URL. Default stores SQLite at backend/data/app.db.
DATABASE_URL=sqlite:///./data/app.db