# Telary Color backend — environment template.
# Copy to backend/.env and adjust for your LAN. Never commit .env.
# Loaded by app/core/config.py (pydantic-settings).

# Application title shown in OpenAPI / Swagger UI.
APP_NAME=Telary Color API

# SQLAlchemy database URL. Default stores SQLite at backend/data/app.db.
DATABASE_URL=sqlite:///./data/app.db

# JWT signing (auth spec): HS256 with a 12h expiry. SECRET_KEY MUST be
# overridden in production (any long random string).
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12

# Seed admin bootstrap (ADR-10): env-configured first, secure default
# fallback. Override BOTH in production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=telary-admin